<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>45.1.0</version>
		<relativePath />
	</parent>

	<groupId>sc.fiji</groupId>
	<artifactId>HDF5_Vibez</artifactId>
	<version>1.1.2-SNAPSHOT</version>

	<name>HDF5 Vibez</name>
	<description>HDF5 plugin for ImageJ and Fiji.</description>
	<url>https://imagej.net/HDF5_Vibez</url>
	<inceptionYear>2011</inceptionYear>
	<organization>
		<name>Fiji</name>
		<url>http://fiji.sc/</url>
	</organization>
	<licenses>
		<license>
			<name>GNU General Public License v3+</name>
			<url>http://www.gnu.org/licenses/gpl.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<!-- See https://imagej.net/Team -->
		<developer>
			<id>rejsmont</id>
			<name>Radoslaw Ejsmont</name>
			<roles>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
		<developer>
			<id>ctrueden</id>
			<name>Curtis Rueden</name>
			<url>https://imagej.net/User:Rueden</url>
			<roles>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Olaf Ronneberger</name>
			<roles><role>founder</role></roles>
		</contributor>
		<contributor>
			<name>Matthias Schlachter</name>
			<roles><role>founder</role></roles>
		</contributor>
		<contributor>
			<name>Kyle Douglass</name>
			<properties><id>kmdouglass</id></properties>
		</contributor>
		<contributor>
			<name>Kun Liu</name>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/fiji</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/fiji/HDF5_Vibez</connection>
		<developerConnection>scm:git:git@github.com:fiji/HDF5_Vibez</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/fiji/HDF5_Vibez</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/fiji/HDF5_Vibez/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/fiji/HDF5_Vibez/actions</url>
	</ciManagement>

	<properties>
		<scijava.jvm.version>8</scijava.jvm.version>
		<package-name>sc.fiji.hdf5</package-name>

		<license.licenseName>gpl_v2</license.licenseName>
		<license.copyrightOwners>Fiji developers.</license.copyrightOwners>

		<!-- NB: Deploy releases to the SciJava Maven repository. -->
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>

		<janelia-jhdf5.version>22.03.01-SNAPSHOT</janelia-jhdf5.version>
		<!-- pom-scijava manages older bytedeco versions; match what janelia-jhdf5 is built against. -->
		<javacpp.version>1.5.15-SNAPSHOT</javacpp.version>
		<hdf5.version>2.2.0-${javacpp.version}</hdf5.version>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
		<!-- org.bytedeco snapshots (javacpp, hdf5) needed by janelia-jhdf5 until they are released. -->
		<repository>
			<id>central-portal-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases><enabled>false</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>janelia-jhdf5</artifactId>
			<version>${janelia-jhdf5.version}</version>
		</dependency>

		<!-- Test scope -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- hdf.hdf5lib.H5 needs an slf4j binding at runtime; Fiji provides one, tests don't. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
